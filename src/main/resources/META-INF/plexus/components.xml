<?xml version="1.0" encoding="UTF-8"?>
<component-set>
    <components>
        <component>
            <role>com.gradle.develocity.agent.maven.api.DevelocityListener</role>
            <role-hint>quarkus-build-caching-develocity-listener</role-hint>
            <implementation>com.gradle.QuarkusBuildCachingDevelocityListener</implementation>
            <description>Makes the Quarkus goals cacheable</description>
            <isolated-realm>false</isolated-realm>
        </component>
        <component>
            <role>org.apache.maven.AbstractMavenLifecycleParticipant</role>
            <role-hint>quarkus-build-caching-lifecycle-participant</role-hint>
            <implementation>com.gradle.QuarkusBuildCachingLifecycleParticipant</implementation>
            <description>Registers the Quarkus goals the caching relies on</description>
            <isolated-realm>false</isolated-realm>
        </component>
        <component>
            <role>org.apache.maven.execution.MojoExecutionListener</role>
            <role-hint>quarkus-build-caching-mojo-execution-listener</role-hint>
            <implementation>com.gradle.QuarkusBuildCachingMojoExecutionListener</implementation>
            <description>Orders the native-image configuration and restores the Quarkus artifact descriptor</description>
            <isolated-realm>false</isolated-realm>
        </component>
    </components>
</component-set>
